# Database — PostgreSQL (required for Render and recommended for local dev)
# Local: use free Neon/Supabase or Docker Postgres. Render: set automatically via Blueprint.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth (use long random string in production; Render generates this automatically)
AUTH_SECRET="change_me_in_production_min_32_chars"

# Test user (for seed)
TEST_USER_EMAIL="test@fitness.app"
TEST_USER_PASSWORD="test12345"
